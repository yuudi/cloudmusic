# Devcontainer already injects DATABASE_URL and REDIS_URL using service names.
# For a server running on the host, use forwarded ports as below.
DATABASE_URL=postgres://cloudmusic:cloudmusic@localhost:5432/cloudmusic_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0
HTTP_ADDR=:8080
LOG_LEVEL=info
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DEPENDENCY_TIMEOUT=3s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
